# ── Required for the public (HTTPS) setup in compose.yaml ──
# Your domain, pointed at this server. Caddy gets a certificate for it automatically.
DOMAIN=home.example.com
# The exact address people type. Passkeys and CSRF checks are tied to it.
APP_URL=https://home.example.com

# Your time zone, used for "today" in logs. Each household also sets its own in Settings.
TZ=America/Toronto

# ── Optional ──
# Let anyone create a new household from the sign-in page (default: false; invites only).
# ALLOW_SIGNUP=false
# Fixed first-run setup code instead of a random one printed in the log.
# SETUP_CODE=
# Sign-in attempts allowed per IP address per 15 minutes.
# LOGIN_RATE_LIMIT=20
# Session length and idle timeout, in days.
# SESSION_DAYS=30
# SESSION_IDLE_DAYS=14
# Name shown in authenticator apps and passkey prompts.
# APP_NAME=Finta
# Log each request (method, path, status, time). Never logs bodies.
# LOG_REQUESTS=false
